# Production Environment Configuration

# Database (Use managed PostgreSQL service in production)
DATABASE_URL=postgresql://promptx_user:secure_password@db.example.com:5432/promptx_prod
POSTGRES_PASSWORD=secure_database_password

# Authentication (Generate secure random strings)
JWT_SECRET=your_super_secure_jwt_secret_at_least_64_characters_long

# AI Services (Required for gameplay)
AI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4
IMAGE_GENERATION_API_KEY=your_dalle_api_key_here

# Server Configuration
NODE_ENV=production
PORT=3001

# Frontend URLs (Update with your domain)
FRONTEND_API_URL=https://your-domain.com/api
FRONTEND_WS_URL=wss://your-domain.com

# Optional: Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379

# Optional: Email service (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password

# Optional: File storage (for user uploads)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_BUCKET_NAME=promptx-assets
AWS_REGION=us-east-1

# Security
CORS_ORIGIN=https://your-domain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn
LOG_LEVEL=info