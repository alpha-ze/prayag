{
  "name": "prompt-x-backend",
  "version": "1.0.0",
  "description": "PROMPT X Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "NODE_ENV=development tsx watch src/index-local.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:local": "tsx src/database/migrate-local.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:seed:local": "tsx src/database/seed-local.ts",
    "db:reset": "tsx src/database/reset.ts",
    "setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "seed:game": "ts-node -r tsconfig-paths/register src/database/seed-game-data.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "groq-sdk": "^1.6.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.20.1",
    "pg": "^8.11.3",
    "socket.io": "^4.7.4",
    "tsconfig-paths": "^4.2.0",
    "tsc-alias": "^1.8.8",
    "uuid": "^9.0.1",
    "ws": "^8.21.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
